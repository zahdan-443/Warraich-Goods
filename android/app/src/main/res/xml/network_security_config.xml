<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Palm Store & Android Enterprise Compliance: Enforce TLS/HTTPS across all connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow trusted secure Firebase & API hosts -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">firebaseapp.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">google.com</domain>
        <domain includeSubdomains="true">open-meteo.com</domain>
        <domain includeSubdomains="true">openstreetmap.org</domain>
        <domain includeSubdomains="true">eklitre.pk</domain>
        <domain includeSubdomains="true">autoones.com</domain>
        <domain includeSubdomains="true">psopk.com</domain>
    </domain-config>
</network-security-config>
