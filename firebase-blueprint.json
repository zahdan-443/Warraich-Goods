{
  "entities": {
    "UserData": {
      "title": "UserData",
      "description": "User specific transport application state sync data",
      "type": "object",
      "properties": {
        "trips": {
          "type": "array"
        },
        "vehicles": {
          "type": "array"
        },
        "drivers": {
          "type": "array"
        },
        "routes": {
          "type": "array"
        },
        "fuelLogs": {
          "type": "array"
        },
        "bilties": {
          "type": "array"
        },
        "role": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile directory entry",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "lastLogin": {
          "type": "string"
        }
      }
    },
    "BiltyAccess": {
      "title": "BiltyAccess",
      "description": "Allowed UID and Email list for Bilty Generator authorization",
      "type": "object",
      "properties": {
        "allowedUIDs": {
          "type": "array"
        },
        "allowedEmails": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "BiltyRecord": {
      "title": "BiltyRecord",
      "description": "Individual bilty receipt record (attachments stored separately)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "biltyNo": { "type": "string" },
        "date": { "type": "string" },
        "vehicleNo": { "type": "string" },
        "driverName": { "type": "string" },
        "attachmentCount": { "type": "number" },
        "legalHold": { "type": "boolean" }
      }
    },
    "BiltyAttachment": {
      "title": "BiltyAttachment",
      "description": "Owner-only compressed ID-card image or legal evidence attachment stored outside main BiltyRecord with 180-day auto-expiry and optional legal hold",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160 },
        "biltyKey": { "type": "string", "maxLength": 80 },
        "biltyNo": { "type": "string", "maxLength": 64 },
        "slot": { "type": "string" },
        "kind": { "type": "string", "enum": ["image", "audio"] },
        "isIdCard": { "type": "boolean" },
        "mimeType": { "type": "string" },
        "dataUrl": { "type": "string" },
        "byteSize": { "type": "number" },
        "createdAt": { "type": "string" },
        "createdAtMs": { "type": "number" },
        "expireAtMs": { "type": "number" },
        "expireAtIso": { "type": "string" },
        "expireAt": { "type": "string", "format": "date-time" },
        "legalHold": { "type": "boolean" }
      },
      "required": ["id", "biltyKey", "slot", "kind", "byteSize", "createdAtMs", "expireAtMs", "legalHold"]
    },
    "CounterData": {
      "title": "CounterData",
      "description": "Sequential counter value",
      "type": "object",
      "properties": {
        "currentValue": { "type": "number" },
        "updatedAt": { "type": "string" }
      }
    },
    "CompanyProfile": {
      "title": "CompanyProfile",
      "description": "Company branding, contact info, and registration details",
      "type": "object",
      "properties": {
        "nameUr": { "type": "string" },
        "nameEn": { "type": "string" },
        "ownerName": { "type": "string" },
        "phoneNumbers": { "type": "string" },
        "headOfficeUr": { "type": "string" },
        "headOfficeEn": { "type": "string" },
        "ntn": { "type": "string" },
        "taglineUr": { "type": "string" },
        "logoUrl": { "type": "string" }
      }
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of fleet and bilty operations",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "category": { "type": "string" }
      }
    },
    "HazardReport": {
      "title": "HazardReport",
      "description": "Crowd-sourced road hazard alert report",
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": ["checkpoint", "flooding", "accident", "closure", "traffic"]
        },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "cityNear": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "reporterUid": { "type": "string" }
      },
      "required": ["category", "lat", "lng", "createdAt", "expiresAt", "reporterUid"]
    },
    "CrashReport": {
      "title": "CrashReport",
      "description": "Automated crash telemetry report with hardware and OS metadata",
      "type": "object",
      "properties": {
        "errorName": { "type": "string" },
        "errorMessage": { "type": "string" },
        "stack": { "type": "string" },
        "componentStack": { "type": "string" },
        "deviceModel": { "type": "string" },
        "platform": { "type": "string" },
        "appVersion": { "type": "string" },
        "url": { "type": "string" },
        "userUid": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["errorMessage", "appVersion", "timestamp"]
    },
    "PublicBiltyVerification": {
      "title": "PublicBiltyVerification",
      "description": "Sanitized public bilty verification document containing ONLY biltyNo, biltyDate, origin, destination, goodsDescription, weightOrQty, vehicleNo, and status",
      "type": "object",
      "properties": {
        "biltyNo": { "type": "string" },
        "biltyDate": { "type": "string" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "goodsDescription": { "type": "string" },
        "weightOrQty": { "type": "string" },
        "vehicleNo": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["biltyNo", "biltyDate", "origin", "destination", "goodsDescription", "weightOrQty", "vehicleNo", "status"]
    },
    "BranchConfig": {
      "title": "BranchConfig",
      "description": "Branch configuration with localized name, address, phone, starting Bilty sequence, and active flag",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9_-]+$" },
        "code": { "type": "string", "maxLength": 16 },
        "nameUr": { "type": "string", "maxLength": 160 },
        "nameEn": { "type": "string", "maxLength": 160 },
        "addressUr": { "type": "string", "maxLength": 300 },
        "addressEn": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 120 },
        "ntn": { "type": "string", "maxLength": 40 },
        "companyHeaderUr": { "type": "string", "maxLength": 200 },
        "companyHeaderEn": { "type": "string", "maxLength": 200 },
        "proprietorNameUr": { "type": "string", "maxLength": 160 },
        "proprietorNameEn": { "type": "string", "maxLength": 160 },
        "taglineUr": { "type": "string", "maxLength": 300 },
        "ownerDisplayName": { "type": "string", "maxLength": 120 },
        "startingBiltySeq": { "type": "number" },
        "ownerEmail": { "type": "string", "maxLength": 160 },
        "isHeadOffice": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nameUr", "nameEn", "addressUr", "addressEn", "phone", "startingBiltySeq", "active"]
    },
    "BranchStaffMember": {
      "title": "BranchStaffMember",
      "description": "Branch-scoped staff member role, custom permission toggles, and status (never stores App Creator)",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 160 },
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 120 },
        "branchId": { "type": "string", "maxLength": 64 },
        "branchNameUr": { "type": "string", "maxLength": 160 },
        "branchNameEn": { "type": "string", "maxLength": 160 },
        "branchOwnerEmail": { "type": "string", "maxLength": 160 },
        "presetRole": {
          "type": "string",
          "enum": ["branch_owner", "branch_manager", "munshi", "accountant", "viewer"]
        },
        "permissions": { "type": "object" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "addedBy": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "branchId", "presetRole", "permissions", "status"]
    },
    "UserBranchAccess": {
      "title": "UserBranchAccess",
      "description": "Flat per-email mirror of active or revoked branch assignment for instant auth lookup",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 160 },
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 120 },
        "branchId": { "type": "string", "maxLength": 64 },
        "branchNameUr": { "type": "string", "maxLength": 160 },
        "branchNameEn": { "type": "string", "maxLength": 160 },
        "branchOwnerEmail": { "type": "string", "maxLength": 160 },
        "presetRole": {
          "type": "string",
          "enum": ["branch_owner", "branch_manager", "munshi", "accountant", "viewer"]
        },
        "permissions": { "type": "object" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "addedBy": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "branchId", "presetRole", "permissions", "status"]
    },
    "SignedInDirectoryEntry": {
      "title": "SignedInDirectoryEntry",
      "description": "Signed-in Google user directory entry for branch staff onboarding (never records App Creator)",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 160 },
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "lastLogin": { "type": "string" }
      },
      "required": ["email", "uid", "lastLogin"]
    }
  },
  "firestore": {
    "/usersData/{userId}": {
      "schema": "UserData",
      "description": "User account documents containing user app data"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/users/{userId}/collections/{collectionId}": {
      "schema": "UserData",
      "description": "User isolated nested collections for trips, vehicles, drivers, routes, fuel, and bilties"
    },
    "/branches/{branchId}": {
      "schema": "BranchConfig",
      "description": "Multi-branch definitions managed by App Creator"
    },
    "/branches/{branchId}/staff/{emailKey}": {
      "schema": "BranchStaffMember",
      "description": "Branch staff roster keyed by lowercase Gmail (Creator excluded)"
    },
    "/branches/{branchId}/collections/{collectionId}": {
      "schema": "UserData",
      "description": "Branch-scoped legacy collection mirrors and tombstones"
    },
    "/branches/{branchId}/biltiesDocs/{docId}": {
      "schema": "BiltyRecord",
      "description": "Branch-scoped individual Bilty documents"
    },
    "/branches/{branchId}/addaPendingFreight/{itemId}": {
      "schema": "UserData",
      "description": "Branch-scoped isolated pending freight receivables inside Adda Panel"
    },
    "/branches/{branchId}/addaPendingCommissions/{itemId}": {
      "schema": "UserData",
      "description": "Branch-scoped isolated pending commissions inside Adda Panel"
    },
    "/branches/{branchId}/addaBills/{billId}": {
      "schema": "UserData",
      "description": "Branch-scoped isolated party freight & commission bills inside Adda Panel"
    },
    "/branches/{branchId}/khataSettings/{settingId}": {
      "schema": "UserData",
      "description": "Branch-scoped Khata settings and tombstones config"
    },
    "/branches/{branchId}/ledgerAccounts/{accountId}": {
      "schema": "UserData",
      "description": "Branch-scoped party ledger accounts"
    },
    "/branches/{branchId}/ledgerAccounts/{accountId}/entries/{entryId}": {
      "schema": "UserData",
      "description": "Branch-scoped party ledger entries"
    },
    "/branches/{branchId}/cashbookEntries/{cashId}": {
      "schema": "UserData",
      "description": "Branch-scoped cashbook entries"
    },
    "/branches/{branchId}/khataBills/{billId}": {
      "schema": "UserData",
      "description": "Branch-scoped Khata invoices and bills"
    },
    "/branches/{branchId}/khataEmployees/{employeeId}": {
      "schema": "UserData",
      "description": "Branch-scoped employee master records"
    },
    "/branches/{branchId}/khataEmployeeEntries/{entryId}": {
      "schema": "UserData",
      "description": "Branch-scoped employee salary and advance entries"
    },
    "/branches/{branchId}/khataReceivingPoints/{pointId}": {
      "schema": "UserData",
      "description": "Branch-scoped receiving point master records"
    },
    "/branches/{branchId}/khataReceivingEntries/{entryId}": {
      "schema": "UserData",
      "description": "Branch-scoped receiving point ledger entries"
    },
    "/branches/{branchId}/khataDailyExpenses/{expenseId}": {
      "schema": "UserData",
      "description": "Branch-scoped categorized daily expenses"
    },
    "/userBranchAccess/{emailKey}": {
      "schema": "UserBranchAccess",
      "description": "Per-email branch assignment and permission mirror"
    },
    "/signedInDirectory/{emailKey}": {
      "schema": "SignedInDirectoryEntry",
      "description": "Non-owner signed-in Google user directory for easy staff selection"
    },
    "/publicBiltyVerifications/{docId}": {
      "schema": "PublicBiltyVerification",
      "description": "Public bilty verification records readable anonymously for website QR verification"
    },
    "/admins/{adminId}": {
      "schema": "UserProfile",
      "description": "System administrator and fleet owner records"
    },
    "/access/biltyAccess": {
      "schema": "BiltyAccess",
      "description": "Global access configuration for bilty feature"
    },
    "/bilties/{biltyId}": {
      "schema": "BiltyRecord",
      "description": "Global bilty documents for authorized creation and access"
    },
    "/counters/{counterId}": {
      "schema": "CounterData",
      "description": "Transaction-based sequential counters for bilty and invoice numbering"
    },
    "/settings/companyProfile": {
      "schema": "CompanyProfile",
      "description": "Company profile configuration"
    },
    "/activityLog/{logId}": {
      "schema": "ActivityLog",
      "description": "System activity logs"
    },
    "/hazardReports/{reportId}": {
      "schema": "HazardReport",
      "description": "Crowd-sourced active highway hazard reports"
    },
    "/crashReports/{reportId}": {
      "schema": "CrashReport",
      "description": "Automated device diagnostics and crash telemetry logs"
    },
    "/users/{userId}/khataBills/{billId}": {
      "schema": "UserData",
      "description": "User isolated invoices and bills"
    },
    "/users/{userId}/khataEmployees/{employeeId}": {
      "schema": "UserData",
      "description": "User isolated employee master records (no government IDs)"
    },
    "/users/{userId}/khataEmployeeEntries/{entryId}": {
      "schema": "UserData",
      "description": "User isolated employee salary, advance, deduction, bonus, and allowance entries"
    },
    "/users/{userId}/khataReceivingPoints/{pointId}": {
      "schema": "UserData",
      "description": "User isolated receiving point master records"
    },
    "/users/{userId}/khataReceivingEntries/{entryId}": {
      "schema": "UserData",
      "description": "User isolated receiving point received/paid ledger entries"
    },
    "/users/{userId}/khataDailyExpenses/{expenseId}": {
      "schema": "UserData",
      "description": "User isolated categorized daily expenses mirrored to cashbook without double counting"
    },
    "/users/{userId}/biltyAttachments/{attachmentId}": {
      "schema": "BiltyAttachment",
      "description": "Owner-only separated compressed ID-card photos and legal attachments with 180-day retention and legal hold"
    }
  }
}
