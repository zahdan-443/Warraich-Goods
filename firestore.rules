rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is the verified App Owner (case-insensitive email)
    function isOwner() {
      return isSignedIn() &&
        request.auth.token != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'warraichgoods43@gmail.com' &&
        (!('email_verified' in request.auth.token) || request.auth.token.email_verified == true);
    }

    // Helper function to safely check if non-owner is explicitly authorized bilty staff
    function isStaffAuthorized(data) {
      return (
        ('allowedUIDs' in data &&
         data.allowedUIDs is list &&
         request.auth.uid in data.allowedUIDs) ||
        ('allowedEmails' in data &&
         data.allowedEmails is list &&
         request.auth.token != null &&
         request.auth.token.email != null &&
         (!('email_verified' in request.auth.token) || request.auth.token.email_verified == true) &&
         request.auth.token.email.lower() in data.allowedEmails)
      );
    }

    // Helper function to check if user is authorized to manage bilties (Owner or authorized staff)
    function isBiltyAuthorized() {
      return isSignedIn() && (
        isOwner() ||
        (
          exists(/databases/$(database)/documents/access/biltyAccess) &&
          isStaffAuthorized(get(/databases/$(database)/documents/access/biltyAccess).data)
        )
      );
    }

    // Helper function to prevent non-owners from promoting themselves or setting admin/owner roles
    function isNotSelfPromoting() {
      return isOwner() || (
        (resource == null ?
          (!('role' in request.resource.data) || (request.resource.data.role != 'owner' && request.resource.data.role != 'admin')) :
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        )
      );
    }

    // Helper function to enforce strictly sanitized non-PII, non-financial fields in public verifications
    // Allowed ONLY: biltyNo, biltyDate, origin, destination, goodsDescription, weightOrQty, vehicleNo, status
    // Strictly FORBIDDEN: CNICs, phone numbers, freight amounts, payment, driver details, or party names
    function hasOnlyPublicBiltyFields() {
      let allowedKeys = [
        'biltyNo', 'biltyDate', 'origin', 'destination',
        'goodsDescription', 'weightOrQty', 'vehicleNo', 'status'
      ];
      let forbiddenKeys = [
        'senderCnic', 'receiverCnic', 'driverCnic', 'cnic',
        'senderMobile', 'receiverMobile', 'mobileNo', 'phone', 'senderPhone', 'receiverPhone',
        'total', 'advance', 'payable', 'freight', 'price', 'charges', 'commission', 'paymentStatus',
        'driverName', 'driverLicense', 'senderName', 'receiverName', 'senderAddress', 'receiverAddress',
        'podConfirmation', 'receivedBy', 'ownerUid'
      ];
      let d = request.resource.data;
      return d.keys().hasAll(allowedKeys) &&
             d.keys().hasOnly(allowedKeys) &&
             !d.keys().hasAny(forbiddenKeys) &&
             d.biltyNo is string && d.biltyNo.size() >= 1 && d.biltyNo.size() <= 64 &&
             d.biltyDate is string && d.biltyDate.size() <= 64 &&
             d.origin is string && d.origin.size() <= 120 &&
             d.destination is string && d.destination.size() <= 120 &&
             d.goodsDescription is string && d.goodsDescription.size() <= 300 &&
             d.weightOrQty is string && d.weightOrQty.size() <= 120 &&
             d.vehicleNo is string && d.vehicleNo.size() <= 64 &&
             d.status is string && d.status.size() >= 1 && d.status.size() <= 64;
    }

    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict user data isolation: every user only has their own data and backups
    match /usersData/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Play Store account deletion requests (30-day grace period tracking & external web form submission)
    match /accountDeletionRequests/{requestId} {
      // Allow signed-in users to manage their own deletion request; owner can view
      allow read: if (isSignedIn() && (request.auth.uid == requestId || (resource != null && resource.data.userId == request.auth.uid) || isOwner())) ||
                     (resource != null && resource.data.referenceId != null);
      allow update, delete: if isSignedIn() && (request.auth.uid == requestId || (resource != null && resource.data.userId == request.auth.uid) || isOwner());

      // Allow creation by authenticated users (via in-app modal) OR unauthenticated users (via external deletion web form)
      allow create: if request.resource.data.keys().hasAll(['userEmail', 'requestedAt', 'scheduledFor', 'status', 'referenceId']) &&
                    request.resource.data.keys().hasOnly(['userId', 'userEmail', 'requestedAt', 'scheduledFor', 'status', 'referenceId', 'reason', 'source']) &&
                    request.resource.data.userEmail is string && request.resource.data.userEmail.size() <= 100 &&
                    request.resource.data.status in ['pending_deletion', 'deleted'] &&
                    request.resource.data.referenceId is string && request.resource.data.referenceId.size() <= 64;
    }

    // User profile entries and user-isolated nested collections
    // (trips, vehicles, drivers, routes, fuel, private ledger, private bilties)
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId && isNotSelfPromoting();

      match /{subcollection=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Access configuration for Bilty Generator authorization (Confidential: ONLY Fleet Owner can read or write)
    match /access/biltyAccess {
      allow read, write: if isOwner();
    }

    // Explicitly DENY top-level private bilties (private bilties live strictly under users/{userId}/collections/bilties)
    match /bilties/{biltyId} {
      allow read, write: if false;
    }

    // Public bilty verification records (doc ID = uppercase biltyNo, read allowed for anyone for QR verification; create/update/delete restricted to authorized bilty accounts)
    match /publicBiltyVerifications/{docId} {
      allow read: if true;
      allow create, update: if isBiltyAuthorized() &&
                               docId is string &&
                               docId.size() >= 1 &&
                               docId.size() <= 64 &&
                               docId == docId.upper() &&
                               request.resource.data.biltyNo == docId &&
                               hasOnlyPublicBiltyFields();
      allow delete: if isBiltyAuthorized();
    }

    // Counters collection for transaction-based sequential Bilty allocation
    // Restrict write strictly to authorized bilty accounts with integer counter values
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isBiltyAuthorized() &&
                   request.resource.data.keys().hasOnly(['currentValue', 'value', 'updatedAt']) &&
                   (
                     ('currentValue' in request.resource.data && (request.resource.data.currentValue is int || request.resource.data.currentValue is number) && request.resource.data.currentValue >= 0) ||
                     ('value' in request.resource.data && (request.resource.data.value is int || request.resource.data.value is number) && request.resource.data.value >= 0)
                   );
    }

    // Company Profile and System Settings (All can read, ONLY Owner can write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // System Admins collection (ONLY Owner can read and write)
    match /admins/{adminId} {
      allow read, write: if isOwner();
    }

    // Activity Log (Owner can read and manage, signed-in users can create entries)
    match /activityLog/{logId} {
      allow read: if isOwner();
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    // Crowd-sourced road hazard reports (read for signed in users; create/delete restricted to reporter; community flagging supported)
    match /hazardReports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                    request.resource.data.reporterUid == request.auth.uid &&
                    request.resource.data.keys().hasAll(['category', 'lat', 'lng', 'createdAt', 'expiresAt', 'reporterUid']) &&
                    request.resource.data.keys().hasOnly(['category', 'lat', 'lng', 'cityNear', 'createdAt', 'expiresAt', 'reporterUid', 'flags', 'flaggedBy', 'flagReasons']) &&
                    request.resource.data.category in ['checkpoint', 'flooding', 'accident', 'closure', 'traffic'] &&
                    request.resource.data.lat is number && request.resource.data.lat >= 23.0 && request.resource.data.lat <= 38.0 &&
                    request.resource.data.lng is number && request.resource.data.lng >= 60.0 && request.resource.data.lng <= 78.0 &&
                    request.resource.data.createdAt == request.time;
      allow delete: if isOwner() || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      // Allow community drivers to flag inaccurate or inappropriate hazards (Play Store UGC requirement)
      allow update: if isSignedIn() &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flags', 'flaggedBy', 'flagReasons']) &&
                    request.resource.data.flags is int &&
                    request.resource.data.flags >= resource.data.flags &&
                    request.resource.data.flags <= 100 &&
                    request.resource.data.flaggedBy is list &&
                    request.resource.data.flaggedBy.size() <= 100;
    }

    // Automated Crash Diagnostics & Telemetry (Enforce strict size caps against Denial of Wallet; read/delete strictly Fleet Owner)
    match /crashReports/{reportId} {
      allow read, delete: if isOwner();
      allow create: if request.resource.data.keys().hasAll(['errorMessage', 'appVersion', 'createdAt']) &&
                    request.resource.data.keys().hasOnly(['errorName', 'errorMessage', 'stack', 'componentStack', 'deviceModel', 'platform', 'appVersion', 'url', 'userUid', 'createdAt']) &&
                    request.resource.data.errorMessage is string && request.resource.data.errorMessage.size() <= 500 &&
                    (!('stack' in request.resource.data) || (request.resource.data.stack is string && request.resource.data.stack.size() <= 1000)) &&
                    (!('componentStack' in request.resource.data) || (request.resource.data.componentStack is string && request.resource.data.componentStack.size() <= 500)) &&
                    (!('deviceModel' in request.resource.data) || (request.resource.data.deviceModel is string && request.resource.data.deviceModel.size() <= 100)) &&
                    (!('errorName' in request.resource.data) || (request.resource.data.errorName is string && request.resource.data.errorName.size() <= 100)) &&
                    (!('platform' in request.resource.data) || (request.resource.data.platform is string && request.resource.data.platform.size() <= 50)) &&
                    (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 200)) &&
                    (!('userUid' in request.resource.data) || (request.resource.data.userUid is string && request.resource.data.userUid.size() <= 128)) &&
                    request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 50 &&
                    request.resource.data.createdAt == request.time;
      allow update: if false;
    }
  }
}
