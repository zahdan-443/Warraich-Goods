rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is the verified App Owner (case-insensitive email)
    function isOwner() {
      return isSignedIn() &&
        request.auth.token != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'warraichgoods43@gmail.com' &&
        (!('email_verified' in request.auth.token) || request.auth.token.email_verified == true);
    }

    // Helper function to check if user is authorized to manage official documents (strictly verified Fleet Owner)
    function isBiltyAuthorized() {
      return isOwner();
    }

    // Helper function to prevent non-owners from promoting themselves or setting admin/owner roles
    function isNotSelfPromoting() {
      return isOwner() || (
        (resource == null ?
          (!('role' in request.resource.data) || (request.resource.data.role != 'owner' && request.resource.data.role != 'admin')) :
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        )
      );
    }

    // Helper function to enforce strictly sanitized non-PII, non-financial fields in public verifications
    // Allowed ONLY: biltyNo, biltyDate, origin, destination, goodsDescription, weightOrQty, vehicleNo, status
    // Strictly FORBIDDEN: CNICs, phone numbers, freight amounts, payment, driver details, or party names
    function hasOnlyPublicBiltyFields() {
      let allowedKeys = [
        'biltyNo', 'biltyDate', 'origin', 'destination',
        'goodsDescription', 'weightOrQty', 'vehicleNo', 'status'
      ];
      let forbiddenKeys = [
        'senderCnic', 'receiverCnic', 'driverCnic', 'cnic',
        'senderMobile', 'receiverMobile', 'mobileNo', 'phone', 'senderPhone', 'receiverPhone',
        'total', 'advance', 'payable', 'freight', 'price', 'charges', 'commission', 'paymentStatus',
        'driverName', 'driverLicense', 'senderName', 'receiverName', 'senderAddress', 'receiverAddress',
        'podConfirmation', 'receivedBy', 'ownerUid'
      ];
      let payload = request.resource.data;
      return payload.keys().hasAll(allowedKeys) &&
             payload.keys().hasOnly(allowedKeys) &&
             !payload.keys().hasAny(forbiddenKeys) &&
             payload.biltyNo is string && payload.biltyNo.size() >= 1 && payload.biltyNo.size() <= 64 &&
             payload.biltyDate is string && payload.biltyDate.size() <= 64 &&
             payload.origin is string && payload.origin.size() <= 120 &&
             payload.destination is string && payload.destination.size() <= 120 &&
             payload.goodsDescription is string && payload.goodsDescription.size() <= 300 &&
             payload.weightOrQty is string && payload.weightOrQty.size() <= 120 &&
             payload.vehicleNo is string && payload.vehicleNo.size() <= 64 &&
             payload.status is string && payload.status.size() >= 1 && payload.status.size() <= 64;
    }

    // Helper function to validate atomic single-increment unique-UID hazard flagging (#24)
    function isValidHazardFlagUpdate() {
      let prevFlags = ('flags' in resource.data && resource.data.flags is int) ? resource.data.flags : 0;
      let hasPrevArray = ('flaggedBy' in resource.data && resource.data.flaggedBy is list);
      let nextFlags = request.resource.data.flags;
      let nextFlaggedBy = request.resource.data.flaggedBy;
      return isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flags', 'flaggedBy', 'flagReasons']) &&
        nextFlags is int &&
        nextFlags == prevFlags + 1 &&
        nextFlags <= 100 &&
        nextFlaggedBy is list &&
        nextFlaggedBy.size() <= 100 &&
        request.auth.uid in nextFlaggedBy &&
        (
          (!hasPrevArray && nextFlaggedBy.size() == 1) ||
          (
            hasPrevArray &&
            !(request.auth.uid in resource.data.flaggedBy) &&
            nextFlaggedBy.size() == resource.data.flaggedBy.size() + 1 &&
            nextFlaggedBy.hasAll(resource.data.flaggedBy)
          )
        );
    }

    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict user data isolation: every user only has their own data and backups
    match /usersData/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Play Store account deletion requests (30-day grace period tracking & external web form submission)
    match /accountDeletionRequests/{requestId} {
      // Strictly authenticated request owners or Fleet Owner only (never expose deletion request PII publicly)
      allow read, update, delete: if isSignedIn() && (request.auth.uid == requestId || (resource != null && resource.data.userId == request.auth.uid) || isOwner());

      // Allow creation by authenticated users (via in-app modal) OR external deletion web form with strict schema/id/status validation (#25)
      allow create: if (requestId.matches('^(web_|app_)[a-zA-Z0-9_-]{3,80}$') || (isSignedIn() && requestId == request.auth.uid) || isOwner()) &&
                    request.resource.data.keys().hasAll(['userEmail', 'requestedAt', 'scheduledFor', 'status', 'referenceId']) &&
                    request.resource.data.keys().hasOnly(['userId', 'userEmail', 'requestedAt', 'scheduledFor', 'status', 'referenceId', 'reason', 'source']) &&
                    request.resource.data.userEmail is string &&
                    request.resource.data.userEmail.size() >= 5 &&
                    request.resource.data.userEmail.size() <= 100 &&
                    request.resource.data.userEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
                    request.resource.data.requestedAt is string &&
                    request.resource.data.requestedAt.size() >= 10 &&
                    request.resource.data.requestedAt.size() <= 64 &&
                    request.resource.data.requestedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}.*$') &&
                    request.resource.data.scheduledFor is string && request.resource.data.scheduledFor.size() >= 10 && request.resource.data.scheduledFor.size() <= 64 &&
                    (request.resource.data.status == 'pending_deletion' || (isOwner() && request.resource.data.status == 'deleted')) &&
                    request.resource.data.referenceId is string &&
                    request.resource.data.referenceId.size() >= 3 &&
                    request.resource.data.referenceId.size() <= 64 &&
                    (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 300)) &&
                    (!('source' in request.resource.data) || request.resource.data.source in ['web_form', 'in_app']) &&
                    (!('userId' in request.resource.data) || (isSignedIn() && request.resource.data.userId == request.auth.uid));
    }

    // User profile entries and user-isolated nested collections
    // (trips, vehicles, drivers, routes, fuel, private ledger, private bilties)
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId && isNotSelfPromoting();

      // Strictly owner-only freight attachments (<= 400 KB hard cap, 180-day TTL / legal hold)
      match /biltyAttachments/{attachmentId} {
        allow read, delete: if isOwner() && request.auth.uid == userId;
        allow create, update: if isOwner() &&
                                 request.auth.uid == userId &&
                                 attachmentId is string &&
                                 attachmentId.size() >= 1 &&
                                 attachmentId.size() <= 160 &&
                                 request.resource.data.id is string &&
                                 request.resource.data.biltyKey is string &&
                                 request.resource.data.byteSize is number &&
                                 request.resource.data.byteSize >= 0 &&
                                 request.resource.data.byteSize <= 409600 &&
                                 request.resource.data.expireAtMs is number &&
                                 request.resource.data.legalHold is bool;
      }

      match /{subcollection=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId && subcollection[0] != 'biltyAttachments';
      }
    }

    // Access configuration for Bilty Generator authorization (Confidential: ONLY Fleet Owner can read or write)
    match /access/biltyAccess {
      allow read, write: if isOwner();
    }

    // Explicitly DENY top-level private bilties (private bilties live strictly under users/{userId}/collections/bilties)
    match /bilties/{biltyId} {
      allow read, write: if false;
    }

    // Public bilty verification records (#23: single-document get by QR code allowed; bulk collection list restricted to authorized accounts)
    match /publicBiltyVerifications/{docId} {
      allow get: if true;
      allow list: if isBiltyAuthorized();
      allow create, update: if isBiltyAuthorized() &&
                               docId is string &&
                               docId.size() >= 1 &&
                               docId.size() <= 64 &&
                               docId == docId.upper() &&
                               request.resource.data.biltyNo == docId &&
                               hasOnlyPublicBiltyFields();
      allow delete: if isBiltyAuthorized();
    }

    // Counters collection for transaction-based sequential Bilty allocation
    // Restrict write strictly to authorized bilty accounts with integer counter values
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isBiltyAuthorized() &&
                   request.resource.data.keys().hasOnly(['currentValue', 'value', 'updatedAt']) &&
                   (
                     ('currentValue' in request.resource.data && (request.resource.data.currentValue is int || request.resource.data.currentValue is number) && request.resource.data.currentValue >= 0) ||
                     ('value' in request.resource.data && (request.resource.data.value is int || request.resource.data.value is number) && request.resource.data.value >= 0)
                   );
    }

    // Company Profile and System Settings (All can read, ONLY Owner can write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // System Admins collection (ONLY Owner can read and write)
    match /admins/{adminId} {
      allow read, write: if isOwner();
    }

    // Activity Log (Owner can read and manage, signed-in users can create schema-validated entries and delete their own on account deletion #18)
    match /activityLog/{logId} {
      allow read: if isOwner() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
                    request.resource.data.keys().hasAll(['action', 'timestamp', 'uid', 'category']) &&
                    request.resource.data.keys().hasOnly(['id', 'timestamp', 'uid', 'email', 'action', 'details', 'category']) &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.action is string && request.resource.data.action.size() >= 1 && request.resource.data.action.size() <= 160 &&
                    request.resource.data.timestamp is string && request.resource.data.timestamp.size() <= 64 &&
                    request.resource.data.category in ['auth', 'bilty', 'settings', 'fleet', 'export', 'error', 'sync'] &&
                    (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 600)) &&
                    (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 160)) &&
                    (!('id' in request.resource.data) || (request.resource.data.id is string && request.resource.data.id.size() <= 128));
      allow update: if isOwner();
      allow delete: if isOwner() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Crowd-sourced road hazard reports (#24: enforce zero-initialized flags & atomic +1 per-UID flagging)
    match /hazardReports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                    request.resource.data.reporterUid == request.auth.uid &&
                    request.resource.data.keys().hasAll(['category', 'lat', 'lng', 'createdAt', 'expiresAt', 'reporterUid']) &&
                    request.resource.data.keys().hasOnly(['category', 'lat', 'lng', 'cityNear', 'createdAt', 'expiresAt', 'reporterUid', 'flags', 'flaggedBy', 'flagReasons']) &&
                    request.resource.data.category in ['checkpoint', 'flooding', 'accident', 'closure', 'traffic'] &&
                    request.resource.data.lat is number && request.resource.data.lat >= 23.0 && request.resource.data.lat <= 38.0 &&
                    request.resource.data.lng is number && request.resource.data.lng >= 60.0 && request.resource.data.lng <= 78.0 &&
                    (!('flags' in request.resource.data) || request.resource.data.flags == 0) &&
                    (!('flaggedBy' in request.resource.data) || (request.resource.data.flaggedBy is list && request.resource.data.flaggedBy.size() == 0)) &&
                    request.resource.data.createdAt == request.time;
      allow delete: if isOwner() || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      allow update: if isValidHazardFlagUpdate();
    }

    // Automated Crash Diagnostics & Telemetry (#25 require authenticated userUid match; #18 allow own delete)
    match /crashReports/{reportId} {
      allow read: if isOwner() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow delete: if isOwner() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow create: if isSignedIn() &&
                    request.resource.data.keys().hasAll(['errorMessage', 'appVersion', 'userUid', 'createdAt']) &&
                    request.resource.data.keys().hasOnly(['errorName', 'errorMessage', 'stack', 'componentStack', 'deviceModel', 'platform', 'appVersion', 'url', 'userUid', 'createdAt']) &&
                    request.resource.data.userUid is string &&
                    request.resource.data.userUid == request.auth.uid &&
                    request.resource.data.userUid.size() <= 128 &&
                    request.resource.data.errorMessage is string && request.resource.data.errorMessage.size() <= 500 &&
                    (!('stack' in request.resource.data) || (request.resource.data.stack is string && request.resource.data.stack.size() <= 1000)) &&
                    (!('componentStack' in request.resource.data) || (request.resource.data.componentStack is string && request.resource.data.componentStack.size() <= 500)) &&
                    (!('deviceModel' in request.resource.data) || (request.resource.data.deviceModel is string && request.resource.data.deviceModel.size() <= 100)) &&
                    (!('errorName' in request.resource.data) || (request.resource.data.errorName is string && request.resource.data.errorName.size() <= 100)) &&
                    (!('platform' in request.resource.data) || (request.resource.data.platform is string && request.resource.data.platform.size() <= 50)) &&
                    (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 200)) &&
                    request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 50 &&
                    request.resource.data.createdAt == request.time;
      allow update: if false;
    }
  }
}
