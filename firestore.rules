rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is the Owner / Admin with verified email
    function isOwner() {
      return isSignedIn() &&
        request.auth.token != null &&
        request.auth.token.email != null &&
        request.auth.token.email == 'warraichgoods43@gmail.com' &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true;
    }

    // Helper function to check if user is authorized to manage bilties
    function isBiltyAuthorized() {
      return isSignedIn() && (
        isOwner() ||
        (
          exists(/databases/$(database)/documents/access/biltyAccess) &&
          (
            request.auth.uid in get(/databases/$(database)/documents/access/biltyAccess).data.allowedUIDs ||
            (
              request.auth.token != null &&
              request.auth.token.email != null &&
              request.auth.token.email in get(/databases/$(database)/documents/access/biltyAccess).data.allowedEmails
            )
          )
        )
      );
    }

    // Helper function to prevent non-owners from promoting themselves or setting admin/owner roles
    function isNotSelfPromoting() {
      return isOwner() || (
        (resource == null ?
          (!('role' in request.resource.data) || (request.resource.data.role != 'owner' && request.resource.data.role != 'admin')) :
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        )
      );
    }

    // Helper function to enforce non-PII and non-financial fields in public verifications
    function hasOnlyPublicBiltyFields() {
      let allowedKeys = [
        'id', 'biltyNo', 'vehicleNo', 'date', 'branch', 'driverName',
        'sendingCity', 'receivingCity', 'senderName', 'receiverName',
        'qty', 'itemDescription', 'weight', 'consignor', 'consignee',
        'receivedBy', 'podConfirmation', 'isDelivered', 'verifiedPublicly',
        'createdAt', 'updatedAt'
      ];
      let forbiddenKeys = [
        'senderCnic', 'receiverCnic', 'senderMobile', 'receiverMobile',
        'mobileNo', 'senderPhone', 'receiverPhone', 'total', 'advance',
        'payable', 'freight', 'price', 'cnic', 'phone'
      ];
      return request.resource.data.keys().hasOnly(allowedKeys) &&
             !request.resource.data.keys().hasAny(forbiddenKeys);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User personal transport app root data
    match /usersData/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // User profile entries and nested collections (trips, vehicles, drivers, routes, fuel, private ledger)
    // - Owner can read all user profiles (for user management)
    // - Users can read/write their own profile (with self-promotion protection)
    // - Users can read/write all their own nested collections
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwner());
      allow write: if isSignedIn() && request.auth.uid == userId && isNotSelfPromoting();

      match /{subcollection=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Access configuration for Bilty Generator authorization (Confidential: ONLY Fleet Owner warraichgoods43@gmail.com can read or write)
    match /access/biltyAccess {
      allow read, write: if isOwner();
    }

    // Explicitly DENY top-level private bilties (private bilties live under users/{userId}/collections/bilties)
    match /bilties/{biltyId} {
      allow read, write: if false;
    }

    // Public bilty verification records (read allowed for anyone for QR verification; write strictly restricted to authorized users with schema validation)
    match /publicBiltyVerifications/{docId} {
      allow read: if true;
      allow create, update: if isBiltyAuthorized() && hasOnlyPublicBiltyFields();
      allow delete: if isOwner();
    }

    // Counters collection for transaction-based sequential Bilty allocation
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isBiltyAuthorized();
    }

    // Company Profile and System Settings (All can read, ONLY Owner can write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // System Admins collection (ONLY Owner can read and write)
    match /admins/{adminId} {
      allow read, write: if isOwner();
    }

    // Activity Log (Owner can read and manage, signed-in users can create entries)
    match /activityLog/{logId} {
      allow read: if isOwner();
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    // Crowd-sourced road hazard reports (read for signed in users; create/delete restricted to reporter; no updates)
    match /hazardReports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
      allow update: if false;
    }
  }
}
