rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is the Owner / Admin (via email, custom claims, or admin collection)
    function isOwner() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'warraichgoods43@gmail.com') ||
        (request.auth.token.role != null && (request.auth.token.role == 'owner' || request.auth.token.role == 'admin')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Helper function to check if user is an Owner or in access/biltyAccess.allowedUIDs / allowedEmails
    function isBiltyAuthorized() {
      return isSignedIn() && (
        isOwner() ||
        (
          exists(/databases/$(database)/documents/access/biltyAccess) &&
          (
            request.auth.uid in get(/databases/$(database)/documents/access/biltyAccess).data.allowedUIDs ||
            (request.auth.token.email != null && request.auth.token.email in get(/databases/$(database)/documents/access/biltyAccess).data.allowedEmails)
          )
        )
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User personal transport app root data
    match /usersData/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // User profile entries and nested collections (trips, vehicles, drivers, routes, fuel, bilties)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /collections/{collectionId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Access configuration for Bilty Generator authorization (Public read so client can verify permission immediately, ONLY Fleet Owner can write)
    match /access/biltyAccess {
      allow read: if true;
      allow write: if isOwner();
    }

    // Bilties collection (Read & write allowed ONLY if authenticated user is an Owner or listed in access/biltyAccess.allowedUIDs / allowedEmails)
    match /bilties/{biltyId} {
      allow read, write: if isBiltyAuthorized();
    }

    // Counters collection for transaction-based sequential Bilty allocation
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Company Profile and System Settings (All can read, ONLY Owner can write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // System Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // Activity Log (Owner can read and manage, signed-in users can create entries)
    match /activityLog/{logId} {
      allow read: if isOwner();
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }
  }
}
