rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is the verified App Owner (case-insensitive email)
    function isOwner() {
      return isSignedIn() &&
        request.auth.token != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'warraichgoods43@gmail.com' &&
        (!('email_verified' in request.auth.token) || request.auth.token.email_verified == true);
    }

    // Helper function to safely check if non-owner is explicitly authorized bilty staff
    function isStaffAuthorized(data) {
      return (
        ('allowedUIDs' in data &&
         data.allowedUIDs is list &&
         request.auth.uid in data.allowedUIDs) ||
        ('allowedEmails' in data &&
         data.allowedEmails is list &&
         request.auth.token != null &&
         request.auth.token.email != null &&
         (!('email_verified' in request.auth.token) || request.auth.token.email_verified == true) &&
         request.auth.token.email.lower() in data.allowedEmails)
      );
    }

    // Helper function to check if user is authorized to manage bilties (Owner or authorized staff)
    function isBiltyAuthorized() {
      return isSignedIn() && (
        isOwner() ||
        (
          exists(/databases/$(database)/documents/access/biltyAccess) &&
          isStaffAuthorized(get(/databases/$(database)/documents/access/biltyAccess).data)
        )
      );
    }

    // Helper function to prevent non-owners from promoting themselves or setting admin/owner roles
    function isNotSelfPromoting() {
      return isOwner() || (
        (resource == null ?
          (!('role' in request.resource.data) || (request.resource.data.role != 'owner' && request.resource.data.role != 'admin')) :
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        )
      );
    }

    // Helper function to enforce non-sensitive, non-financial fields in public verifications
    // Allowed: biltyNo, date, sendingCity, receivingCity, vehicleNo, itemDescription, weight, qty, verifiedPublicly, createdAt, updatedAt
    // Strictly FORBIDDEN: PII, CNICs, phone numbers, names, freight price, advance, payable, charges, totals, or delivery tracking status
    function hasOnlyPublicBiltyFields() {
      let allowedKeys = [
        'biltyNo', 'date', 'sendingCity', 'receivingCity',
        'itemDescription', 'weight', 'qty', 'vehicleNo',
        'verifiedPublicly', 'createdAt', 'updatedAt'
      ];
      let forbiddenKeys = [
        'senderCnic', 'receiverCnic', 'senderMobile', 'receiverMobile',
        'mobileNo', 'senderPhone', 'receiverPhone', 'total', 'advance',
        'payable', 'freight', 'price', 'cnic', 'phone', 'driverName',
        'senderName', 'receiverName', 'consignor', 'consignee', 'receivedBy', 'podConfirmation', 'isDelivered'
      ];
      return request.resource.data.keys().hasOnly(allowedKeys) &&
             !request.resource.data.keys().hasAny(forbiddenKeys);
    }

    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict user data isolation: every user only has their own data;
    // none of the users can share, access, or see data of any other user
    match /usersData/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // User profile entries and user-isolated nested collections
    // (trips, vehicles, drivers, routes, fuel, private ledger, private bilties)
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId && isNotSelfPromoting();

      match /{subcollection=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Access configuration for Bilty Generator authorization (Confidential: ONLY Fleet Owner can read or write)
    match /access/biltyAccess {
      allow read, write: if isOwner();
    }

    // Explicitly DENY top-level private bilties (private bilties live strictly under users/{userId}/collections/bilties)
    match /bilties/{biltyId} {
      allow read, write: if false;
    }

    // Public bilty verification records (read allowed for anyone for QR verification; create/update restricted to authenticated users with public schema validation)
    match /publicBiltyVerifications/{docId} {
      allow read: if true;
      allow create, update: if isSignedIn() && hasOnlyPublicBiltyFields();
      allow delete: if isOwner();
    }

    // Counters collection for transaction-based sequential Bilty allocation
    // Any signed-in user creating a bilty can atomically reserve/increment numbers without permission error
    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    // Company Profile and System Settings (All can read, ONLY Owner can write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // System Admins collection (ONLY Owner can read and write)
    match /admins/{adminId} {
      allow read, write: if isOwner();
    }

    // Activity Log (Owner can read and manage, signed-in users can create entries)
    match /activityLog/{logId} {
      allow read: if isOwner();
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }

    // Crowd-sourced road hazard reports (read for signed in users; create/delete restricted to reporter; no updates)
    match /hazardReports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
      allow update: if false;
    }
  }
}
